{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TajsAnagrams",
  "version": "0.1.0",
  "identifier": "tv.tajemnik.tajsanagrams",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "create": false, "title": "TajsAnagrams", "width": 1200, "height": 800, "minWidth": 760, "minHeight": 600, "backgroundColor": "#17191e", "devtools": false, "zoomHotkeysEnabled": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'", "capabilities": [{ "identifier": "main", "windows": ["main"], "permissions": [] }] }
  },
  "bundle": { "active": false }
}
