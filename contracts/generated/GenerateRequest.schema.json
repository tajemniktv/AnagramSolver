{
  "$defs": {
    "HintMode": {
      "enum": [
        "any",
        "exactly_one"
      ],
      "type": "string"
    },
    "ShortPolicy": {
      "enum": [
        "none",
        "common",
        "all"
      ],
      "type": "string"
    },
    "Strategy": {
      "enum": [
        "prefix",
        "diverse"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow_repeat": {
      "type": "boolean"
    },
    "candidate_budget": {
      "format": "uint",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "exclude_regex": {
      "default": [],
      "description": "Case-insensitive regular expressions searched against normalized words.",
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "excluded": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "extra_short_words": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "forbid_chars": {
      "default": "",
      "type": "string"
    },
    "hint_mode": {
      "$ref": "#/$defs/HintMode"
    },
    "hints": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "max_word_length": {
      "format": "uint",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "max_words": {
      "format": "uint",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "min_word_length": {
      "format": "uint",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "min_words": {
      "format": "uint",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "min_zipf": {
      "format": "double",
      "minimum": 0,
      "type": "number"
    },
    "required": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "short_policy": {
      "$ref": "#/$defs/ShortPolicy",
      "default": "common"
    },
    "strategy": {
      "$ref": "#/$defs/Strategy"
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "text",
    "min_words",
    "max_words",
    "min_word_length",
    "max_word_length",
    "min_zipf",
    "candidate_budget",
    "allow_repeat",
    "strategy",
    "hint_mode"
  ],
  "title": "GenerateRequest",
  "type": "object"
}
